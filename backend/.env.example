# Copy this file to backend/.env (never commit .env).
PORT=3000

# Optional: switches on the AI-assisted free-text intake (Groq). Without it, intake uses plain keyword matching.
# Get a free key at https://console.groq.com . On Replit, put it in Secrets instead of a file.
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current model names.
GROQ_MODEL=llama-3.3-70b-versatile
# Max AI requests per day across all visitors (protects the free quota).
INTAKE_DAILY_CAP=300
